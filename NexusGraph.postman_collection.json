    {
      "name": "4. Multi-Hop Blast Radius Simulation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startNodeId\": \"VULN-001\",\n  \"maxHops\": 5\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/graph/blast-radius",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "graph",
            "blast-radius"
          ]
        },
        "description": "Executes 1-5 hop variable length openCypher traversal to compute total financial contract risk and affected customers."
      },
      "response": []
    },
    {
      "name": "5. Discover Single Point of Failure Bottlenecks",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/graph/bottlenecks",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "graph",
            "bottlenecks"
          ]
        },
        "description": "Discovers structural bottlenecks and single-source supplier/component dependencies."
      },
      "response": []
    },
    {
      "name": "6. Execute Parameterised openCypher Query",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cypher\": \"MATCH path = (v:Vulnerability {id: $startNodeId})-[*1..5]->(c:Customer) RETURN path, sum(c.annualContractValue) AS totalRisk\",\n  \"params\": {\n    \"startNodeId\": \"VULN-001\"\n  }\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/graph/query",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "graph",
            "query"
          ]
        },
        "description": "Executes arbitrary parameterised openCypher queries."
      },
      "response": []
    }
